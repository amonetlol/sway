{
  "layer": "top",
  "position": "top",
  "height": 40,
  "exclusive": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": -10,
  "reload_style_on_change": true,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "niri/workspaces",
    "group/clock-pill"
  ],
  "modules-center": [],
  "modules-right": [
    "memory",
    "cpu",
    "tray",
    "pulseaudio",
    "custom/dunst"
  ],
  "group/clock-pill": {
    "orientation": "horizontal",
    "modules": [
      "clock#date",
      "clock#time"
    ]
  },
  "tray": {
    "on-click": "toggle",
    "tooltip": true,
    "spacing": 10,
    "icon-size": 16,
    "icons-size-miltiplier": 1,
    "show-passive-items": false
  },
  "custom/dunst": {
    "format": "{}",
    "interval": 2,
    "signal": 8,
    "exec": "~/.config/waybar/dunst.sh",
    "on-click": "~/.config/waybar/dunst.sh toggle",
    "tooltip": true
  },
  "niri/workspaces": {
    "format": "{value}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    }
  }
}
