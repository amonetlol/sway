[Unit]
Description=Sway themed notification center
PartOf=sway-themed-session.target

[Service]
ExecCondition=%h/.config/sway/scripts/backend-only.py waybar
Environment=GDK_BACKEND=wayland
Environment=GDK_DISABLE=dmabuf
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=GSK_RENDERER=gl
Type=simple
ExecStart=/usr/bin/swaync -c %h/.config/sway/current/swaync/config.json -s %h/.config/sway/current/swaync/style.css
Restart=on-failure
RestartSec=2
