[Unit]
Description=Sway themed Waybar (two bars)
PartOf=sway-themed-session.target

[Service]
ExecCondition=%h/.config/sway/scripts/backend-only.py waybar
Type=simple
ExecStart=/usr/bin/waybar -c %h/.config/sway/current/waybar/config -s %h/.config/sway/current/waybar/style.css
ExecReload=/usr/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=2
