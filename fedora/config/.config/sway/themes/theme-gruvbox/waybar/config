[
  {
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 20,
    "margin-right": 20,
    "id": "bar-1",
    "modules-right": [
      "idle_inhibitor",
      "custom/arrow2",
      "memory",
      "custom/arrow2",
      "cpu",
      "custom/arrow2",
      "network",
      "custom/arrow2",
      "pulseaudio",
      "custom/arrow2",
      "clock"
    ],
    "modules-left": [
      "custom/power",
      "custom/file",
      "custom/notification",
      "tray",
      "sway/scratchpad",
      "custom/arrow",
      "sway/workspaces",
      "custom/layout"
    ],
    "clock": {
      "format": " {:%H:%M · %d/%m}",
      "on-click": "@@HOME@@/.config/sway/scripts/desktop.py calendar",
      "locale": "",
      "justify": "center",
      "tooltip": false
    },
    "custom/arrow": {
      "format": "⟫",
      "tooltip": false
    },
    "custom/arrow2": {
      "format": "⟪",
      "tooltip": false
    },
    "custom/file": {
      "format": "☰",
      "min-length": 1,
      "tooltip": false,
      "justify": "center",
      "menu-file": "@@HOME@@/.config/sway/current/waybar/file_menu.xml",
      "menu": "on-click",
      "menu-actions": {
        "Home": "@@HOME@@/.local/bin/nautilus @@HOME@@",
        "Downloads": "@@HOME@@/.local/bin/nautilus @@HOME@@/Downloads",
        "Screenshots": "@@HOME@@/.local/bin/nautilus @@HOME@@/Pictures/Screenshots",
        "Config": "@@HOME@@/.local/bin/nautilus @@HOME@@/.config/sway",
        "Sway Config": "@@HOME@@/.local/bin/kitty -e nvim @@HOME@@/.config/sway/config"
      }
    },
    "custom/power": {
      "format": "⏻",
      "tooltip-format": "Energia",
      "on-click": "@@HOME@@/.config/sway/scripts/power-menu.sh"
    },
    "custom/notification": {
      "tooltip": true,
      "min-length": 1,
      "justify": "center",
      "format": "{icon}",
      "format-icons": {
        "notification": "",
        "none": "",
        "dnd-notification": "",
        "dnd-none": "",
        "inhibited-notification": "",
        "inhibited-none": "",
        "dnd-inhibited-notification": "",
        "dnd-inhibited-none": ""
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
      "tooltip-format": "Central de notificações"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": " ",
        "deactivated": " "
      },
      "min-length": 2,
      "start-activated": true
    },
    "pulseaudio": {
      "max-volume": 150,
      "format": "{icon} {volume}%",
      "format-icons": [
        "",
        "",
        ""
      ],
      "nospacing": 1,
      "format-muted": "⦸",
      "on-click": "pavucontrol",
      "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "tooltip": false,
      "scroll-step": 3
    },
    "sway/scratchpad": {
      "format": "{icon} {count}",
      "format-icons": "✦",
      "tooltip": true,
      "tooltip-format": "{app}: {title}"
    },
    "sway/window": {
      "format": "{}",
      "tooltip": false
    },
    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "tooltip": false,
      "warp-on-scroll": false,
      "format": "{icon} {name}",
      "format-icons": {
        "urgent": "●",
        "focused": "●",
        "default": "○"
      }
    },
    "tray": {
      "expand": true,
      "show-passive-items": true,
      "icon-size": 16,
      "spacing": 15
    },
    "modules-center": [
      "mpris"
    ],
    "memory": {
      "format": "󰾆 {used:0.1f} GiB",
      "interval": 30,
      "justify": "center",
      "tooltip": false
    },
    "cpu": {
      "format": "CPU {usage}%",
      "format-alt": "{load}% Load",
      "tooltip": false,
      "interval": 30,
      "on-click-right": "@@HOME@@/.local/bin/kitty -e btop"
    },
    "network": {
      "format-wifi": " {essid}",
      "format-disconnected": "󰤮 No Network",
      "format-disabled": "󰤮 Wifi Disabled",
      "tooltip-format": "  ⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}\n\nSignal Strength ({signalStrength}%)",
      "interval": 5,
      "menu": "on-click",
      "menu-file": "@@HOME@@/.config/sway/current/waybar/network.xml",
      "menu-actions": {
        "Connection Interface": "@@HOME@@/.local/bin/kitty -e nmtui",
        "Wifi On": "nmcli radio wifi on",
        "Wifi Off": "nmcli radio wifi off"
      },
      "format-ethernet": "󰈀 {ipaddr}"
    },
    "mpris": {
      "format": "{status_icon} {artist} {status_icon} {album} - <i>{title}</i> {status_icon}",
      "max-length": 35,
      "artist-len": 20,
      "album-len": 20,
      "title-len": 100,
      "elipses": "...",
      "justify": "center",
      "interval": 1,
      "status-icons": {
        "playing": "●",
        "paused": "○"
      },
      "ignored-players": [
        "firefox"
      ]
    },
    "height": 28,
    "margin-bottom": 0,
    "custom/layout": {
      "exec": "@@HOME@@/.config/sway/scripts/active-layout.py",
      "return-type": "json",
      "interval": 1,
      "format": "{}",
      "tooltip": true
    }
  }
]
