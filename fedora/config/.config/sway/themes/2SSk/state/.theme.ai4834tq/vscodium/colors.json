  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#979da9",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "#a3be8c"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "constant.character",
          "constant.other"
        ],
        "settings": {
          "foreground": "#d08770"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "storage.modifier",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#81a1c1"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call",
          "variable.function"
        ],
        "settings": {
          "foreground": "#88c0d0"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class",
          "storage.type",
          "entity.other.inherited-class"
        ],
        "settings": {
          "foreground": "#ebcb8b"
        }
      },
      {
        "scope": [
          "variable.parameter",
          "variable.language",
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#88c0d0"
        }
      },
      {
        "scope": [
          "entity.name.tag",
          "invalid"
        ],
        "settings": {
          "foreground": "#bf616a"
        }
      },
      {
        "scope": [
          "punctuation",
          "keyword.operator",
          "meta.brace"
        ],
        "settings": {
          "foreground": "#979da9"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable"
        ],
        "settings": {
          "foreground": "#d8dee9"
        }
      },
      {
        "scope": [
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "#88c0d0",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.inline.raw",
          "markup.fenced_code"
        ],
        "settings": {
          "foreground": "#d08770"
        }
      },
      {
        "scope": [
          "markup.underline.link"
        ],
        "settings": {
          "foreground": "#88c0d0"
        }
      },
      {
        "scope": [
          "markup.inserted"
        ],
        "settings": {
          "foreground": "#a3be8c"
        }
      },
      {
        "scope": [
          "markup.deleted"
        ],
        "settings": {
          "foreground": "#bf616a"
        }
      },
      {
        "scope": [
          "markup.changed"
        ],
        "settings": {
          "foreground": "#ebcb8b"
        }
      }
    ]
  }
