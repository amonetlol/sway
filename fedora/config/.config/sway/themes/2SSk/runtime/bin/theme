#!/usr/bin/env python3
import importlib.util,json,os,subprocess,sys,shutil
from pathlib import Path
P=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(P/'scripts'))
from appearance import icons,refresh_nautilus
spec=importlib.util.spec_from_file_location('render2ssk',P/'runtime/lib/desktop/theme_render.py')
r=importlib.util.module_from_spec(spec);spec.loader.exec_module(r)
state=P/'state/theme'
family,mode='tokyonight','dark'
if (state/'current').exists():
 values=dict(line.split('=',1) for line in (state/'current').read_text().splitlines() if '=' in line)
 family,mode=values.get('family',family),values.get('mode',mode)
a=sys.argv[1:];command=a[0] if a else 'current'
if command=='current':print(family,mode);raise SystemExit
if command=='list':
 if '--json' in a:print(json.dumps(r.palettes()))
 else:print('\n'.join(('* ' if f==family else '  ')+f for f in r.files()))
 raise SystemExit
if command=='set':
 family=a[1]
 if '--mode' in a:mode=a[a.index('--mode')+1]
elif command=='mode':mode=('light' if mode=='dark' else 'dark') if a[1]=='toggle' else a[1]
elif command=='wallpaper':
 if family!='matugen':raise SystemExit
elif command!='apply':raise SystemExit('Usage: theme set FAMILY [--mode dark|light] | mode dark|light|toggle | list | current')
if family=='matugen':
 image=P/'state/wallpaper'
 if not image.exists():raise SystemExit('Escolha um wallpaper primeiro.')
 output=P/'state/themes/matugen.toml';output.parent.mkdir(parents=True,exist_ok=True)
 subprocess.run(['python3',str(P/'runtime/lib/desktop/matugen_theme.py'),str(image.resolve()),str(output)],check=True)
r.render(family,mode,state)
for version in ['gtk-3.0','gtk-4.0']:shutil.copy2(state/(version+'.css'),P/'gtk'/version/'gtk.css')
conf=P/'theme.conf';text=conf.read_text()
ui=json.loads((state/'palette.json').read_text())['ui']
icon_theme=icons(P,family,mode,ui['primary'])
updates={'GTK_THEME':'adw-gtk3-dark' if mode=='dark' else 'adw-gtk3','ICON_THEME':icon_theme,'COLOR_SCHEME':'prefer-'+mode}
import re
for key,value in updates.items():text=re.sub('^'+key+'=.*$',key+'='+value,text,flags=re.M)
conf.write_text(text)
ui=json.loads((state/'palette.json').read_text())['ui']
for name in ['main.rasi','power.rasi']:
 f=P/'rofi'/name;s=f.read_text()
 for key,role in [('background','bg'),('foreground','fg'),('surface','surface'),('accent','primary')]:
  s=re.sub(r'(    '+key+r': )#[0-9a-fA-F]{6};',lambda m:m[1]+ui[role]+';',s)
 s=re.sub(r'icon-theme: "[^"]+"','icon-theme: "'+icon_theme+'"',s)
 f.write_text(s)
root=P.parents[1]
active=(root/'current').resolve()==P and Path(os.environ.get('SWAYSOCK','/nonexistent')).is_socket()
if active:
 spec=importlib.util.spec_from_file_location('sway_theme_manager',root/'scripts/theme_manager.py')
 manager=importlib.util.module_from_spec(spec);spec.loader.exec_module(manager)
 manager.desktop(P,manager.meta(P))
 refresh_nautilus()
 lines=[l for l in (state/'i3.conf').read_text().splitlines() if l.startswith('client.')]
 subprocess.run(['swaymsg','-q','; '.join(lines)],check=True)
 subprocess.run(['qs','-p',str(P/'quickshell'),'ipc','call','theme','reload'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
print('2SSk:',family,mode)
