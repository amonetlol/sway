#!/usr/bin/env bash
# rice-gamebar [toggle|open|close]   the game bar (SUPER + G): CPU / GPU, RAM, ping, capture, power mode,
# gaming mode, volume and brightness on one panel over your game.
mkdir -p "$HOME/.config/sway/themes/DarkShadow/cache/rice"
if ! pgrep -f "quickshell/rice-desktop" >/dev/null 2>&1; then
  [ -x "$HOME/.config/sway/themes/DarkShadow/runtime/bin/rice-desktop" ] && "$HOME/.config/sway/themes/DarkShadow/runtime/bin/rice-desktop" ensure >/dev/null 2>&1
  sleep 1
fi
case "${1:-toggle}" in
  toggle|open|close) printf '%s %s\n' "$(date +%s.%N)" "${1:-toggle}" >"$HOME/.config/sway/themes/DarkShadow/cache/rice/gamebar-open" ;;
  *) echo "usage: rice-gamebar [toggle|open|close]" >&2; exit 1 ;;
esac
