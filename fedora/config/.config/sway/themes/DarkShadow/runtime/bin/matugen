#!/bin/sh
# The theme needs the matugen 4.x CLI (--source-color-index, --prefer, --json);
# Fedora's package is 3.1.0, so prefer the 4.2.0 build in /usr/local/bin.
config="$HOME/.config/sway/themes/DarkShadow/config/matugen/config.toml"
if [ -x /usr/local/bin/matugen ]; then
    exec /usr/local/bin/matugen --config "$config" "$@"
fi
if command -v matugen >/dev/null 2>&1; then
    exec matugen --config "$config" "$@"
fi
echo "matugen 4.x nao encontrado; rode fedora/scripts/install-matugen.sh" >&2
exit 127
