#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland
export XCURSOR_THEME=Vimix-cursors XCURSOR_SIZE=24
export LANG=pt_BR.UTF-8
if [[ $(systemd-detect-virt 2>/dev/null || true) == vmware ]] || grep -qi vmware /sys/class/dmi/id/sys_vendor 2>/dev/null; then
  export WLR_NO_HARDWARE_CURSORS=1
  export WLR_RENDERER=pixman
fi
cleanup() { systemctl --user stop sway-session.target 2>/dev/null || true; }
trap cleanup EXIT
trap 'kill -TERM "$sway_pid" 2>/dev/null || true' TERM INT
/usr/bin/sway "$@" &
sway_pid=$!
wait "$sway_pid"
