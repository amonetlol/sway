#!/usr/bin/env bash
set -euo pipefail
THEME_FILE="$HOME/.config/rofi/hotkeys/hotkeys.rasi"
# Toggle apenas deste menu; nao interfere na Waybar ou em outros launchers.
if pgrep -u "$(id -u)" -f '^rofi -dmenu.*hotkeys.rasi' >/dev/null; then
    pkill -u "$(id -u)" -f '^rofi -dmenu.*hotkeys.rasi'
    exit 0
fi
HOTKEYS_DATA=$(cat <<'KEYS'
Super + F1                   │ Guia de atalhos                    │ Ajuda
Super + Enter                │ Kitty                              │ Aplicativos
Super + W                    │ Firefox                            │ Aplicativos
Super + E                    │ Nautilus                           │ Aplicativos
Super + D                    │ Rofi                               │ Aplicativos
Super + Shift + D            │ Executar comando                   │ Aplicativos
Super + X                    │ Wlogout                            │ Sessão
Super + F10                  │ Seletor de wallpapers              │ Wallpaper
Super + M                    │ Alternar resolução do monitor      │ Monitor
Super + V                    │ Clipboard                          │ Clipboard
Super + Q                    │ Fechar janela                      │ Janelas
Super + F                    │ Alternar tela cheia                │ Janelas
Super + T                    │ Alternar janela flutuante          │ Janelas
Super + Shift + Espaço       │ Alternar foco flutuante/ladrilho   │ Janelas
Super + ;                    │ Escolher layout                    │ Janelas
Super + A                    │ Foco no contêiner pai              │ Janelas
Alt + Tab                    │ Alternar janelas/abas/pilhas       │ Navegação
Super + Tab                  │ Alternar workspaces               │ Navegação
Super + Setas                │ Trocar janelas de posição                         │ Navegação
Super + 1…9 / 0              │ Área de trabalho 1…10              │ Áreas
Super + Shift + 1…9 / 0      │ Mover janela para área 1…10        │ Áreas
Super + Ctrl + Shift + Setas │ Mover área para outro monitor      │ Áreas
Super + Menos                │ Exibir scratchpad                  │ Janelas
Super + Shift + Menos        │ Enviar janela ao scratchpad        │ Janelas
Super + Arrastar (esquerdo)  │ Mover janela flutuante             │ Mouse
Super + Arrastar (direito)   │ Redimensionar janela               │ Mouse
Super + L                    │ Bloquear a sessão                  │ Sessão
Super + Shift + R            │ Recarregar configuração Sway       │ Sistema
Volume + / − / Mudo          │ Ajustar volume                     │ Áudio
Tecla de microfone           │ Alternar mudo do microfone         │ Áudio
Play / Pause / Next / Prev   │ Controlar reprodução               │ Mídia
KEYS
)
selected=$(printf '%s\n' "$HOTKEYS_DATA" | rofi -dmenu -i -no-custom -p 'Atalhos Sway' -theme "$THEME_FILE") || exit 0
case "$selected" in
  'Super + Enter '* ) exec "$HOME/.local/bin/kitty-sway" ;;
  'Super + W '* ) exec firefox ;;
  'Super + E '* ) exec "$HOME/.local/bin/nautilus-sway" ;;
  'Super + D '* ) exec rofi -show drun ;;
  'Super + Shift + D '* ) exec rofi -show run ;;
  'Super + X '* ) exec "$HOME/.config/wlogout/launch.sh" ;;
  'Super + F10 '* ) exec "$HOME/.local/bin/rofi-wallpaper" ;;
  'Super + ; '* ) exec "$HOME/.local/bin/sway-layout-menu" ;;
  'Super + T '* ) exec swaymsg floating toggle ;;
  'Super + Menos '* ) exec "$HOME/.local/bin/scratchpad-toggle" ;;
  'Super + M '* ) exec "$HOME/.local/bin/mon" ;;
  'Super + V '* ) exec "$HOME/.local/bin/clipboard-menu" ;;
esac
