#!/usr/bin/env bash
set -euo pipefail
export XDG_CURRENT_DESKTOP=sway
export GSK_RENDERER=cairo GDK_DISABLE=dmabuf
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd PATH WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GSK_RENDERER GDK_DISABLE
  systemctl --user import-environment PATH WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GSK_RENDERER GDK_DISABLE
  systemctl --user reset-failed randow-wallpapers.service waybar.service || true
  systemctl --user start sway-session.target || true
  systemctl --user restart randow-wallpapers.service randow-wallpapers.timer || true
  systemctl --user restart waybar.service || true
else
  dbus-update-activation-environment PATH WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GSK_RENDERER GDK_DISABLE || true
  command -v waybar >/dev/null 2>&1 && waybar >/dev/null 2>&1 &
  if [[ -x "$HOME/.local/bin/random-wallpaper.sh" ]]; then
    "$HOME/.local/bin/random-wallpaper.sh" >/dev/null 2>&1 &
  fi
fi
