#!/usr/bin/env python3
import json,subprocess
p=subprocess.run(['wpctl','get-volume','@DEFAULT_AUDIO_SINK@'],capture_output=True,text=True)
s=p.stdout.strip(); muted='[MUTED]' in s
try: volume=round(float(s.split()[1])*100)
except (IndexError,ValueError): volume=0
icon='󰖁' if muted else ('󰕿' if volume<35 else '󰖀' if volume<70 else '󰕾')
print(json.dumps({'text':f'{icon} {0 if muted else volume}%','tooltip':'Som silenciado' if muted else f'Volume: {volume}%'}))
