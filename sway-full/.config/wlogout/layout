{
  "label": "lock",
  "action": "/usr/bin/swaylock -f -c 303446",
  "text": "Bloquear",
  "keybind": "1"
},
{
  "label": "shutdown",
  "action": "/usr/bin/systemctl poweroff",
  "text": "Desligar",
  "keybind": "2"
},
{
  "label": "reboot",
  "action": "/usr/bin/systemctl reboot",
  "text": "Reiniciar",
  "keybind": "3"
},
{
  "label": "logout",
  "action": "/usr/bin/swaymsg exit",
  "text": "Sair",
  "keybind": "4"
}
