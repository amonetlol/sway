{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "sway/workspaces",
        "custom/playerctl"
    ],
    "modules-center": [
        "custom/date"
    ],
    "modules-right": [
        "memory",
        "cpu",
        "pulseaudio#sink",
        "bluetooth",
        "network"
    ],
    "disk": {
        "interval": 30,
        "format": "{percentage_used}% <span></span>"
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 12,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ]
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "timezone": "America/Sao_Paulo",
        "tooltip-format": "<big>{:%A, %d de %B de %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%A, %d de %B · %H:%M}",
        "format-alt": "{:%d/%m/%Y · %H:%M}",
        "locale": "pt_BR.UTF-8"
    },
    "cpu": {
        "interval": 5,
        "format": " {usage}%",
        "tooltip-format": "CPU: {usage}%",
        "on-click": "\"$HOME/.local/bin/btop-float\""
    },
    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "Memória: {used:0.1f} / {total:0.1f} GiB",
        "on-click": "\"$HOME/.local/bin/btop-float\""
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "network": {
        "interface": "en*",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "",
        "tooltip-format-ethernet": "Ethernet · {ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-linked": "Ethernet · {ifname}\nSem endereço IP",
        "tooltip-format-disconnected": "Ethernet desconectada",
        "on-click": "\"$HOME/.local/bin/rofi-network-menu\""
    },
    "pulseaudio#sink": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-bluetooth-muted": " 0% ",
        "format-muted": " 0%",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "\"$HOME/.local/bin/pavucontrol\"",
        "ignored-sinks": [
            "EasyEffects Sink"
        ]
    },
    "custom/playerctl": {
        "interval": "once",
        "tooltip": true,
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "Playing": "",
            "Paused": "",
            "Stopped": "",
            "default": ""
        },
        "exec": "playerctl metadata --format '{\"alt\": \"{{status}}\", \"tooltip\": \"{{playerName}}:  {{markup_escape(title)}} - {{markup_escape(artist)}}\" }'",
        "on-click": "playerctl play-pause; pkill -RTMIN+5 waybar",
        "on-click-right": "playerctl next; pkill -RTMIN+5 waybar",
        "on-scroll-up": "playerctl position 10+; pkill -RTMIN+5 waybar",
        "on-scroll-down": "playerctl position 10-; pkill -RTMIN+5 waybar",
        "signal": 5
    },
    "custom/border-right": {
        "format": "◗",
        "tooltip": false
    },
    "custom/border-left": {
        "format": "◖",
        "tooltip": false
    },
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": []
        }
    },
    "sway/mode": {
        "format": "{}",
        "tooltip": false
    },
    "sway/window": {
        "separate-outputs": true
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Bluetooth: {device_alias}"
    },
    "custom/date": {
        "exec": "\"$HOME/.local/bin/waybar-date\"",
        "interval": 30,
        "return-type": "json",
        "tooltip": true
    },
    "margin-top": 4,
    "margin-left": 12,
    "margin-right": 12
}
