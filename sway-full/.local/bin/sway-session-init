#!/usr/bin/env bash
set -euo pipefail
export XDG_CURRENT_DESKTOP=sway
export GSK_RENDERER=cairo GDK_DISABLE=dmabuf
dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GSK_RENDERER GDK_DISABLE
systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP GSK_RENDERER GDK_DISABLE
# A sessao anterior pode ter encerrado o socket enquanto o user manager permaneceu ativo.
systemctl --user reset-failed awww.service randow-wallpapers.service waybar.service
systemctl --user restart awww.service
systemctl --user start sway-session.target
systemctl --user restart randow-wallpapers.service randow-wallpapers.timer
systemctl --user restart waybar.service
