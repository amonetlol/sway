configuration {
    window {
        prefer-icon-theme: true;
    }
    modi:                           "window,drun";
    show-icons:                     true;
    display-window:                 "Switch";
    display-drun:                   "Search";
    font:                           "Noto Sans 11";
    hide-scrollbar:                 true;
    kb-row-down:                  "Down,Alt+Tab";
    kb-row-up:                    "Up,Alt+Shift+Tab";
    kb-cancel:                      "Escape,Control+bracketleft,Super+space";
}

* {
    bg0:                           #181616FF;
    bg1:                           #282727FF;
    bg2:                           #28272780;
    bg3:                           #C8C093FF;
    fg0:                           #C5C9C5FF;
    fg1:                           #C5C9C5FF;
    fg2:                           #A6A69CFF;
    fg3:                           #A6A69CFF;
    background-color:              transparent;
    text-color:                    @fg0;
    margin:                        0px;
    padding:                       0px;
    spacing:                       0px;
}

window {
    location:                      north;
    y-offset:                      64px;
    width:                         480px;
    border-radius:                 24px;
    background-color:              @bg0;
}

mainbox {
    padding:                       12px;
}

inputbar {
    background-color:              @bg1;
    border-color:                  @bg3;
    border:                        2px;
    border-radius:                 16px;
    padding:                       8px 16px;
    spacing:                       8px;
    children:                      [ prompt, entry ];
}

prompt {
    text-color:                    @fg2;
}

entry {
    text-color:                    @fg0;
    placeholder:                   "Switch";
    placeholder-color:             @fg3;
}

listview {
    background-color:              transparent;
    margin:                        12px 0 0;
    lines:                         10;
    columns:                       1;
    fixed-height:                   false;
}

element {
    padding:                       8px 16px;
    spacing:                       8px;
    border-radius:                 12px;
}

element normal.normal,
element alternate.normal {
    background-color:              @bg0;
    text-color:                    @fg0;
}

element selected.normal,
element selected.active {
    background-color:              @bg0;
    text-color:                    @fg0;
    border:                        2px;
    border-color:                  @bg3;
}

element normal.active,
element alternate.active {
    background-color:              @bg0;
    text-color:                    @fg0;
}

element-icon {
    size:                          1.2em;
    vertical-align:                 0.5;
}

element-text {
    text-color:                    inherit;
}
