/* ~/.config/hypr-vora/rofi/config.rasi */
@theme "rose-pine.rasi"

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "JetBrainsMono Nerd Font 12";
  terminal: "foot";
  display-drun: "  Apps";
  display-run: "  Run";
  display-window: "  Windows";
  drun-display-format: "{name}";
}
