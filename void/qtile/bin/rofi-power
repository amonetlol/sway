#!/bin/sh
choice=$(printf 'Bloquear\nSair\nSuspender\nReiniciar\nDesligar\n' | rofi -dmenu -i -p Energia) || exit 0
case "$choice" in
 Bloquear) i3lock -c 363646 ;;
 Sair) qtile cmd-obj -o root -f shutdown ;;
 Suspender) loginctl suspend ;;
 Reiniciar) loginctl reboot ;;
 Desligar) loginctl poweroff ;;
esac
